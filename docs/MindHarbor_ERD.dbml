// === USER MODEL === //

// Enum for user roles
Enum UserRole {
    ADMINISTRATOR // system administrator for data collection and overall moderation
    USER // regular user
}

// Enum for user visibilty
Enum UserVisibilityLevel {
    PUBLIC // anyone can see the full profile
    GROUPES_SEULEMENT // only group members can see the full profile
    PRIVE // other users can only see avatar, and username
}

// Enum for user private message level
Enum UserPrivateMessageLevel {
    PERSONNE // does not accept private messages
    MEMBRES_DE_MES_GROUPES // only accepts message from shared group members
    TOUT_LE_MONDE // accepts message from anyone
}

// User Table
Table User {
  userId uuid [primary key]

  email String [not null]
  password String [not null] // hashed in the actual DB
  role UserRole [default: `USER`] // determines user permissions

  username String [not null]
  firstName String [not null]
  lastName String [not null]
  avatarPictureUrl String
  bio String

  // Determines who can view account info outside of the avatar & username
  visibilityLevel UserVisibilityLevel [default: `PRIVE`]
    // Determine who can send private message
  privateMessageLevel UserPrivateMessageLevel [default: `MEMBRES_DE_MES_GROUPES`, not null]

  createdAt datetime [default: `now()`]
  updatedAt datetime
}

// === JOURNAL ENTRY MODEL === //

// JournalEntry Table
Table JournalEntry {
  journalId uuid [primary key, not null]
  userId uuid [ref: > User.userId, not null]

  generalMood int [check: `generalMood 1 >= and generalMood <= 5`, not null]
  energyLevel int [check: `energyLevel 1 >= and energyLevel <= 5`, not null]
  sleepQuality int [check: `sleepQuality 1 >= and sleepQuality <= 5`, not null]
  stessLevel int [check: `stessLevel 1 >= and stessLevel <= 5`, not null]
  keyEvents String [not null]
  dailyGratitude String

  createdAt date [default: `today()`, not null]
  updatedAt datetime [default: `now()`]

  // unicity constraint that prevents multiple daily entry
  indexes {
    (userId, createdAt) [unique]
  }
}

// === ACTIVITY MODEL === //

// Activity Table
Table Activity {
  activityId uuid [primary key]
  name String [not null, unique]
  desc String [not null]

  createdAt datetime [default: `now()`]
  updatedAt datetime [default: `now()`]
}

// === RESOURCE MODEL === //

// Enum for resource category
Enum ResourceCategory {
    ANXIETY
    SLEEP
    RELATIONSHIP
    WORK
    GRIEF
}

// Enum for resource type
Enum ResourceType {
    ARTICLE
    EXERCICE
    FICHE_PRATIQUE
    LIEN_EXTERNE
}

// Resource Table
Table Resource {
  resourceId uuid [primary key]

  name String [not null, unique]
  category ResourceCategory [not null]
  type ResourceType [not null]
  duration float [not null]
  level int [check: `level >= 0`, not null]

  createdAt datetime [default: `now()`]
  updatedAt datetime [default: `now()`]
}

// === GROUP MODEL === //

// Enum for Group Visibility
Enum GroupVisibility {
    PUBLIC
    PRIVE
}

// Enum for Group Member Junction Table
Enum GroupRequestStatus {
    EN_ATTENTE
    ACCEPTEE
    REFUSEE
}

// Enum for Group Member Junction Table
Enum GroupRole {
    MODERATEUR
    MEMBRE
    NON_MEMBRE
}

// Group Table
Table Group {
  groupId uuid [primary key]

  name String [not null]
  theme String [not null]
  desc String [not null]
  rules String [not null]
  visibility GroupVisibility [not null]

  createdAt datetime [default: `now()`]
  updatedAt datetime [default: `now()`]
}

// === POST MODEL === //

// Post Table
Table Post {
  postId uuid [primary key]
  userId uuid [ref: > User.userId]
  groupId uuid [ref: > Group.groupId]

  title String [not null] // title for the post
  body String [not null] // body for the post

  createdAt datetime [default: `now()`]
  updatedAt datetime
}

// === COMMENT MODEL === //

// Comment Table
Table Comment {
  commentId uuid [primary key]
  userId uuid [ref: > User.userId]
  postId uuid [ref: > Post.postId]

  comment String [not null] // the actual comment

  createdAt datetime [default: `now()`]
  updatedAt datetime
}

// === MESSAGE MODEL === //

// Enum for messages read receipt
Enum MessageReadReceipt {
    SENT
    READ
}

// Message Table
Table Message {
  messageId uuid [primary key, unique]
  senderId uuid [ref: > User.userId]
  recipientId uuid [ref: > User.userId]

  message String [not null]
  readReceipt MessageReadReceipt [not null]

  createdAt datetime [default: `now()`]
  updatedAt datetime //essentially readAt but to keep it consistant with the rest of the db renamed to updatedAt
}

// === REPORT MODEL === //

// Enum for report category
Enum ReportCategory {
    INAPPROPRIE
    SPAM
    INQUIETANT
}

// Enum for report status
Enum ReportStatus {
    EN_ATTENTE
    EN_COURS_DE_REVISION
    RESOLUE
    REJETEE
}

// Report Table
Table Report {
 postId uuid [primary key, ref: > Post.postId]
 userId uuid [primary key, ref: > User.userId] // user of the user creating the report

 category ReportCategory [not null]
 status  ReportStatus [default: `EN_ATTENTE`]

 createdAt datetime [default: `now()`]
 updatedAt datetime
}

// === REFRESH TOKEN MODEL === //

// RefreshToken Table
Table RefreshToken {
 refreshTokenId uuid [primary key]

 userId uuid [ref: > User.userId]

 tokenHash varchar
 expiresAt datetime
 createdAt datetime [default: `now()`]
 revokedAt datetime
}

// === JUNCTION TABLES === //

// N-N junction table between JournalEntry and Activity
Table JournalActivity {
    journalId uuid [primary key, ref: > JournalEntry.journalId]
    activityId uuid [primary key, ref: > Activity.activityId]
}

// N-N junction table between User and Resource, to track a users favorite resource
Table Favorite {
    userId uuid [primary key, ref: > User.userId]
    resource uuid [primary key, ref: > Resource.resourceId]

    createdAt datetime [default: `now()`]
}

// junction table between User and groups
Table GroupMember {
    userId uuid [primary key, ref: > User.userId]
    groupId uuid [primary key, ref: > Group.groupId]

    role GroupRole [default: `NON_MEMBRE`]
    requestStatus GroupRequestStatus [default: `EN_ATTENTE`]

    createdAt datetime [default: `now()`]
    updatedAt datetime
}
